# HopTrace local development environment variables.
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# API version (also returned by GET /api/v1/health)
APP_VERSION=0.1.0

# CORS – comma-separated list of allowed browser origins.
# Default targets the local Vite dev server used by the React frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Topology data source.
# "engine"     – HopTrace graph engine (Neo4j with in-memory fallback; default for production/prototype)
# "simulated"  – standalone simulated topology (no Neo4j required)
TOPOLOGY_PROVIDER=engine

# Dependency analysis adapter for affected-subscriber analysis.
# "engine"      – HopTrace graph engine (Neo4j with in-memory fallback; derives affected subscribers)
# "unavailable" – honest default when engine adapter is not connected (returns 503)
# "simulated"   – simulated network dependency mapping for demos
DEPENDENCY_ADAPTER=engine

# Incident explanation provider.
# "unavailable" – honest default; the explain endpoint returns HTTP 503 (no fabrication).
# "sarvam"      – Sarvam AI chat-completions (requires a valid SARVAM_API_KEY below).
EXPLANATION_PROVIDER=unavailable

# Sarvam AI credentials and configuration (used only when EXPLANATION_PROVIDER=sarvam).
# Set SARVAM_API_KEY in your LOCAL .env file only — never commit a real key.
# This file (.env.example) is committed to git; leave SARVAM_API_KEY empty here.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_TIMEOUT_SECONDS=30

# Neo4j connection (only used when TOPOLOGY_PROVIDER=neo4j)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password-here

# SQLite Database
SQLITE_DB_PATH=hoptrace.db
SEED_DEMO_SUBSCRIBERS=true
SEED_DEMO_INCIDENTS=true

# Telemetry Ingestion (optional)
# If set, POST /api/v1/measurements/ingest requires header: X-API-Key
INGEST_API_KEY=

# Run Telemetry Retention (SQLite)
# Maximum number of past test runs and their measurements to retain in SQLite (default: 1000)
RUNS_RETENTION_LIMIT=1000

# Business Impact & SLA Credits
# Fraction of monthly subscriber fee credited per hour of outage (default: 0.02 = 2% per hour)
SLA_CREDIT_RATE_PER_HOUR=0.02

# Outage Notification Provider
# "unavailable" – default honest behavior (returns 503)
# "console"     – local demo provider that logs notifications
# "twilio"      – Twilio SMS / WhatsApp delivery
NOTIFICATION_PROVIDER=unavailable

# Twilio credentials (used only when NOTIFICATION_PROVIDER=twilio)
# Never commit real credentials to git; configure in local .env
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM_NUMBER=
