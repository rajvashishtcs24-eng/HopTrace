# HopTrace local development environment variables.
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# API version (also returned by GET /api/v1/health)
APP_VERSION=0.1.0

# CORS – comma-separated list of allowed browser origins.
# Default targets the local Vite dev server used by the React frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Topology data source.
# "simulated"  – standalone simulated topology (no Neo4j required)
# "engine"     – HopTrace graph engine (Neo4j with in-memory fallback)
TOPOLOGY_PROVIDER=simulated

# Dependency analysis adapter for affected-subscriber analysis.
# "unavailable" – honest default when engine adapter is not connected (returns 503)
# "simulated"   – simulated network dependency mapping for demos
# "engine"      – HopTrace graph engine (when implemented)
DEPENDENCY_ADAPTER=unavailable

# Neo4j connection (only used when TOPOLOGY_PROVIDER=neo4j)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password-here

# SQLite Database
SQLITE_DB_PATH=hoptrace.db
SEED_DEMO_SUBSCRIBERS=true
SEED_DEMO_INCIDENTS=true
